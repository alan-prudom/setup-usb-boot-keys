[Desktop Entry]
Version=1.0
Type=Application
Name=🚀 Run Backup Assistant (CLI)
Comment=Automated Clonezilla & Rescuezilla Network Backup
Exec=xfce4-terminal --title="🚀 Run Backup Assistant" --hold --geometry=105x32 -e "bash -c 'if [ ! -d /home/ubuntu/ntfs_usb ]; then echo \"Initializing storage...\"; sudo /usr/local/bin/mount_ntfs_startup.sh; fi; if [ -f /home/ubuntu/ntfs_usb/run_rescuezilla_backup_cli.sh ]; then sudo bash /home/ubuntu/ntfs_usb/run_rescuezilla_backup_cli.sh; else sudo bash /usr/local/bin/run_rescuezilla_backup_cli.sh; fi'"
Icon=utilities-terminal
Terminal=false
StartupNotify=true
