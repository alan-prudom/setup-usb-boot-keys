[Desktop Entry]
Version=1.0
Type=Application
Name=🛡️ Post-Backup Diagnostic Wizard
Comment=Inspect backup logs and disk telemetry
Exec=xfce4-terminal --title="🛡️ Post-Backup Wizard" --hold --geometry=105x32 -e "sudo /usr/local/bin/post-backup-wizard.sh"
Icon=system-search
Terminal=false
StartupNotify=true
