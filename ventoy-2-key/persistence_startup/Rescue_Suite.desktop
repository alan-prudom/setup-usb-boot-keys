[Desktop Entry]
Version=1.0
Type=Application
Name=🛡️ Unified Rescue & Backup Suite
Comment=Network Storage Setup + Backup, Restore, Clone, Verify, Image Explorer
Exec=xfce4-terminal --title="🛡️ Rescue & Backup Suite" --hold --geometry=110x35 -e "sudo /usr/local/bin/rescue_suite_launcher.sh"
Icon=system-run
